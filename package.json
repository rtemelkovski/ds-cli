{
  "name": "ds-cli",
  "version": "0.1.0",
  "description": "Portable design-token CLI: single canonical source per project, multi-target codegen, strict lint.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ds": "./bin/ds.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/tokens/types.ts"
  },
  "scripts": {
    "ds": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "colorjs.io": "^0.5.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
